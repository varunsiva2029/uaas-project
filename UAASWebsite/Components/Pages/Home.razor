                new("Bosch Rexroth", "/images/vfd/bosch-rexroth.jpg"),
                new("Chinese Drives", "/images/vfd/chinese-drives.jpg"),
                new("Danfoss", "/images/vfd/danfoss.jpg"),
                new("Delta", "/images/vfd/delta.jpg"),
                new("Fuji", "/images/vfd/fuji.jpg"),
                new("GEFRAN", "/images/vfd/gefran.jpg"),
                new("Inovance", "/images/vfd/inovance.jpg"),
                new("INVT", "/images/vfd/invt.jpg"),
                new("KEB", "/images/vfd/keb.jpg"),
                new("L&T", "/images/vfd/lt.jpg"),
                new("MOOG", "/images/vfd/moog.jpg"),
                new("NIDEC", "/images/vfd/nidec.png"),
                new("Phase Motors", "/images/vfd/phase-motors.jpg"),
                new("Schneider", "/images/vfd/schneider.jpg"),
                new("Siemens", "/images/vfd/siemens.jpg"),
