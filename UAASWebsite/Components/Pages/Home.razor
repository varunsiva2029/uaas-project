    }


    /* =========================
       COMPANY IMAGE
       ========================= */

    private void ShowCompanyImage(CompanyItem company)
    {
        SelectedCompany = company;

        SelectedCompanyImage = company.Image;
    }


    /* =========================
       SERVICE REQUEST FORM
       ========================= */

    private string ServiceName = "";

    private string CompanyName = "";

    private string Phone = "";

    private string Email = "";

    private string ServiceType = "";

    private string Description = "";

    private string FormMessage = "";


    private async Task SubmitServiceRequest()
    {
        FormMessage = "";

        if (string.IsNullOrWhiteSpace(ServiceName))
        {
            FormMessage = "Please enter your name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Phone))
        {
            FormMessage = "Please enter your phone number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ServiceType))
        {
            FormMessage = "Please select a service.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Description))
        {
            FormMessage = "Please describe your requirement.";
            return;
        }


        /*
         * Form validation is working here.
         *
         * We will connect this section to your
         * existing Supabase database separately.
         */

        FormMessage =
            "Your service request has been received. Our team will contact you.";


        ServiceName = "";
        CompanyName = "";
        Phone = "";
        Email = "";
        ServiceType = "";
        Description = "";

        await InvokeAsync(StateHasChanged);
    }


    /* =========================
       COMPANY MODEL
       ========================= */

    private class CompanyItem
{
    public string Name { get; set; }="";
    public string Image { get; set; }="";

    public CompanyItem(string name, string image)
    {
        Name = name;
        Image = image;
    }
}

}