            },


            /* =========================
               SERVO
               ========================= */

            "SERVO" => new List<CompanyItem>
            {
                new("ABB", "/images/servo/abb.jpg"),
                new("Baumuller", "/images/servo/baumuller.jpg"),
                new("Bosch Rexroth", "/images/servo/bosch-rexroth.jpg"),
                new("Chinese Drives", "/images/servo/chinese-drives.jpg"),
                new("Danfoss", "/images/servo/danfoss.jpg"),
                new("Delta", "/images/servo/delta.jpg"),
                new("Fuji", "/images/servo/fuji.jpg"),
                new("GEFRAN", "/images/servo/gefran.jpg"),
                new("Inovance", "/images/servo/inovance.jpg"),
                new("INVT", "/images/servo/invt.jpg"),
                new("KEB", "/images/servo/keb.jpg"),
                new("L&T", "/images/servo/lt.jpg"),
                new("Mitsubishi", "/images/servo/mitsubishi.png"),
                new("MOOG", "/images/servo/moog.jpg"),
                new("NIDEC", "/images/servo/nidec.jpg"),
                new("Panasonic", "/images/servo/panasonic.jpg"),
                new("Phase Motors", "/images/servo/phase-motors.jpg"),
                new("Schneider", "/images/servo/schneider.jpg"),
                new("Siemens", "/images/servo/siemens.jpg"),
                new("THM", "/images/servo/thm.jpg"),
                new("Yaskawa", "/images/servo/yaskawa.jpg")
            },


            /* =========================
               PLC
               ========================= */

            "PLC" => new List<CompanyItem>
